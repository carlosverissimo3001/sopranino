# Database
DATABASE_URL=''

# Redis
REDIS_URL=''

# Spotify OAuth
SPOTIFY_CLIENT_ID=''
SPOTIFY_REDIRECT_URI=''

# Session and Auth
SESSION_MAX_AGE_SECONDS=''
TOKEN_ENCRYPTION_KEY='' # 64 chars hex string (32 bytes) for AES-256 encryption
# Production only. Scopes the session cookie to a parent domain so one cookie
# covers the site and the API subdomain, which the websocket needs. Leave unset
# locally: localhost and 127.0.0.1 share no parent domain.
COOKIE_DOMAIN=''

# CORS
# Origins allowed to call the public /demo endpoints, comma separated.
# These get CORS without credentials; leaving it unset blocks the portfolio.
PORTFOLIO_URL=

FRONTEND_URL=''

# Third-party API keys
LAST_FM_API_KEY=''
CLOUDINARY_URL=''
# Unset RESEND_API_KEY and mail is written to the log instead of sent.
# EMAIL_FROM must be at a domain verified in Resend; a subdomain keeps a
# deliverability problem here away from the root domain's reputation.
RESEND_API_KEY=''
# A no-reply address tells the inbox this is one way, which costs trust and
# earns spam reports from people who cannot answer. Use one that reaches you.
EMAIL_FROM='' # e.g. sopranino <hello@mail.example.com>
# Where a reply lands. Without inbound mail on the sending domain, replies to
# EMAIL_FROM go nowhere, so point this at an inbox someone reads.
EMAIL_REPLY_TO=''